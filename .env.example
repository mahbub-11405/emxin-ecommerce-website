# ============================================================
# EMXIN E-COMMERCE - DUCKDNS DEPLOYMENT ENVIRONMENT TEMPLATE
# ============================================================
# HOW TO USE ON EC2:
#   cp .env.example .env
#   nano .env
#   docker compose up -d --build
#
# IMPORTANT:
# - Commit ONLY this .env.example file.
# - NEVER commit the real .env file.
# - This single root .env is the source of configuration for the
#   whole monorepo. Docker Compose passes public build-time values
#   to Frontend/Admin and loads private runtime secrets into Backend.
# ============================================================

# --- APP / PUBLIC URLS ---
APP_ENV=production
APP_NAME=EMXIN Technologies
APP_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_64_CHARS

# DuckDNS test URLs are prefilled below. Replace only when moving to your production domain.
FRONTEND_URL=https://emxin-dev.duckdns.org
ADMIN_URL=https://emxin-admin-dev.duckdns.org
BACKEND_PUBLIC_URL=https://emxin-api-dev.duckdns.org
CORS_ALLOWED_ORIGINS=https://emxin-dev.duckdns.org,https://emxin-admin-dev.duckdns.org
TRUSTED_HOSTS=emxin-api-dev.duckdns.org,localhost,127.0.0.1

# Unique loopback ports exposed by Docker. Host Nginx proxies to these.
FRONTEND_HOST_PORT=4310
ADMIN_HOST_PORT=4320
BACKEND_HOST_PORT=8430

# Public values compiled into Next.js during docker build.
NEXT_PUBLIC_API_URL=https://emxin-api-dev.duckdns.org/api/v1
NEXT_PUBLIC_CDN_URL=https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net
NEXT_PUBLIC_SITE_NAME=EMXIN Technologies

# --- MONGODB ATLAS M0 ---
# Atlas > Database > Connect > Drivers > Python
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=emxin

# --- FIRST SUPER ADMIN ---
# Used only to bootstrap the first Super Admin if none exists.
INITIAL_ADMIN_EMAIL=owner@YOUR_DOMAIN
INITIAL_ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_START
JWT_EXPIRE_MINUTES=720

# --- AWS S3 + CLOUDFRONT MEDIA ---
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Example bucket: emxin-production-media
AWS_S3_BUCKET=emxin-production-media
AWS_S3_PREFIX=media
# AWS CloudFront distribution hostname, e.g. d123abc456.cloudfront.net
AWS_CLOUDFRONT_DOMAIN=YOUR_CLOUDFRONT_DOMAIN.cloudfront.net
AWS_CDN_BASE_URL=https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net
S3_PRESIGNED_UPLOAD_EXPIRE_SECONDS=900

# All logo/favicon/hero/banner/category/product image/video URLs stored in DB
# should be CloudFront URLs generated from AWS_CDN_BASE_URL.

# --- PAYSTATION ---
PAYSTATION_ENABLED=false
PAYSTATION_ENV=sandbox
PAYSTATION_SANDBOX_BASE_URL=https://sandbox.paystation.com.bd
PAYSTATION_LIVE_BASE_URL=https://api.paystation.com.bd
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
PAYSTATION_INITIATE_PATH=/initiate-payment
PAYSTATION_STATUS_PATH=/transaction-status
PAYSTATION_IPN_URL=https://emxin-api-dev.duckdns.org/api/v1/payments/paystation/ipn
PAYSTATION_CALLBACK_URL=https://emxin-dev.duckdns.org/payment-result
PAYSTATION_PAY_WITH_CHARGE=0

# Retail only: COD gets 0%; every successful digital PayStation payment gets 2%.
DIGITAL_PAYMENT_DISCOUNT_PERCENT=2

# Optional manual/fallback accounts. These bootstrap Admin payment settings.
# PayStation settlement destination must also be configured/approved by PayStation.
PAYMENT_BKASH_NUMBER=
PAYMENT_BKASH_ACCOUNT_TYPE=personal
PAYMENT_NAGAD_NUMBER=
PAYMENT_NAGAD_ACCOUNT_TYPE=personal
PAYMENT_BANK_NAME=City Bank
PAYMENT_BANK_ACCOUNT_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_BRANCH=
PAYMENT_BANK_ROUTING_NUMBER=

# --- NISHCHIT SMS / OTP ---
# Test key: nk_test_* (no real SMS / no credits consumed)
# Live key: nk_live_* (real SMS)
NISHCHIT_ENABLED=false
NISHCHIT_API_BASE_URL=https://api.nishchit.tech
NISHCHIT_API_KEY=
NISHCHIT_MESSAGES_PATH=/v1/messages
OTP_EXPIRE_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Keep true only with a test key/non-production testing; set false for live.
OTP_EXPOSE_CODE_IN_TEST=false

# --- COURIER: NEVER AUTO-DISPATCH FROM CHECKOUT ---
# Admin confirms customer first; only then API creates courier consignment.
COURIER_DEFAULT=steadfast

STEADFAST_ENABLED=false
STEADFAST_BASE_URL=
STEADFAST_CREATE_ORDER_PATH=
STEADFAST_STATUS_PATH=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_SECRET=

PATHAO_ENABLED=false
PATHAO_BASE_URL=
PATHAO_TOKEN_PATH=
PATHAO_CREATE_ORDER_PATH=
PATHAO_STATUS_PATH=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_WEBHOOK_SECRET=

# --- COMMERCE DEFAULTS ---
# Bootstrap defaults only; Admin Settings may override them in MongoDB.
DHAKA_DELIVERY_CHARGE=70
OUTSIDE_DHAKA_DELIVERY_CHARGE=130
ESTIMATED_SHIPPING_FROM_QTY=6
EXTRA_SHIPPING_PER_KG=0
BULK_THRESHOLD_QTY=20
BULK_DISCOUNT_PERCENT=5
BULK_ADVANCE_PERCENT=50

# --- ANALYTICS / CRM ---
ENABLE_FIRST_PARTY_ANALYTICS=true
ANALYTICS_SESSION_TTL_DAYS=30

# --- EMAIL / NOTIFICATION (OPTIONAL) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EMXIN Technologies
